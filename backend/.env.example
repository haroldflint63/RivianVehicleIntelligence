# ─────────────────────────────────────────────────────────────────────
#  Rivian Vehicle Intelligence — Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# Groq Cloud — FREE tier (no credit card needed)
# Sign up at: https://console.groq.com
# Dashboard  → API Keys → Create API Key
# Model used: llama-3.3-70b-versatile
# Free limits: 30 req/min | 6 000 tokens/min
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# WebSocket server settings (optional overrides)
WS_HOST=0.0.0.0
WS_PORT=8765
